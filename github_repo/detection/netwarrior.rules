# NetWARRIOR detection rules for Suricata / Snort-compatible engines.
#
# Tuned to the exact payloads and default strings this tool emits. SIDs use the
# local 9000000+ range. Adjust $HOME_NET / $EXTERNAL_NET and the `threshold`
# counts for your environment. Pair with the rate-based detection in DEFENSE.md.
#
# Validate:  suricata -T -S detection/netwarrior.rules -c /etc/suricata/suricata.yaml

# ─── Reflection / amplification: the request payloads NetWARRIOR sends ────────

alert udp any any -> any 123 (msg:"NetWARRIOR NTP monlist amplification request";
    content:"|17 00 03 2a|"; depth:4;
    threshold:type both, track by_src, count 5, seconds 10;
    classtype:attempted-dos; sid:9000001; rev:1;)

alert udp any any -> any 161 (msg:"NetWARRIOR SNMP GetBulk amplification request (public)";
    content:"|02 01 01 04 06|public|a5|"; depth:16;
    threshold:type both, track by_src, count 5, seconds 10;
    classtype:attempted-dos; sid:9000002; rev:1;)

alert udp any any -> any 11211 (msg:"NetWARRIOR memcached amplification request (stats)";
    content:"|00 00 00 00 00 01 00 00|stats|0d 0a|"; depth:16;
    threshold:type both, track by_src, count 3, seconds 10;
    classtype:attempted-dos; sid:9000003; rev:1;)

alert udp any any -> 239.255.255.250 1900 (msg:"NetWARRIOR SSDP ssdp:all amplification/discovery";
    content:"M-SEARCH * HTTP/1.1"; depth:18;
    content:"ST|3a| ssdp|3a|all"; distance:0;
    threshold:type both, track by_src, count 5, seconds 10;
    classtype:attempted-dos; sid:9000004; rev:1;)

alert udp any any -> any 19 (msg:"NetWARRIOR CHARGEN amplification probe";
    dsize:<8;
    threshold:type both, track by_src, count 10, seconds 10;
    classtype:attempted-dos; sid:9000005; rev:1;)

alert udp any any -> any 3799 (msg:"NetWARRIOR RADIUS CoA/Disconnect (PoD) broadcast";
    ip_proto:17;
    threshold:type both, track by_src, count 5, seconds 10;
    classtype:attempted-dos; sid:9000006; rev:1;)

# ─── DNS amplification: crafted ANY query (QTYPE 255) for example/google.com ─

alert udp any any -> any 53 (msg:"NetWARRIOR DNS ANY amplification query";
    byte_test:1,!&,0x80,2;                 # QR=0, it is a query
    content:"|00 00 ff 00 01|"; isdataat:!1,relative;   # QTYPE=ANY QCLASS=IN at end
    threshold:type both, track by_src, count 10, seconds 10;
    classtype:attempted-dos; sid:9000007; rev:1;)

# ─── Name-resolution poisoning (Responder-style) ─────────────────────────────
# LLMNR/mDNS queries go TO the multicast group; an *answer* (QR=1) aimed at the
# multicast address, or any answer for "wpad", is hostile.

alert udp any any -> 224.0.0.252 5355 (msg:"NetWARRIOR LLMNR poisoned answer to multicast group";
    byte_test:1,&,0x80,2;                  # QR=1 in a packet sent to the query group
    classtype:bad-unknown; sid:9000010; rev:1;)

alert udp any 5355 -> $HOME_NET any (msg:"NetWARRIOR/Responder LLMNR answer for wpad";
    byte_test:1,&,0x80,2;
    content:"|04|wpad"; nocase;
    classtype:bad-unknown; sid:9000011; rev:1;)

alert udp any any -> 224.0.0.251 5353 (msg:"NetWARRIOR mDNS poisoned answer to multicast group";
    byte_test:1,&,0x80,2;
    threshold:type both, track by_src, count 3, seconds 10;
    classtype:bad-unknown; sid:9000012; rev:1;)

alert udp any 137 -> 255.255.255.255 137 (msg:"NetWARRIOR NBT-NS broadcast spoofed answer";
    byte_test:1,&,0x80,2;
    threshold:type both, track by_src, count 3, seconds 10;
    classtype:bad-unknown; sid:9000013; rev:1;)

# ─── Layer 2 / DHCP ─────────────────────────────────────────────────────────

alert udp 0.0.0.0 68 -> 255.255.255.255 67 (msg:"NetWARRIOR DHCP starvation (DISCOVER flood, random MACs)";
    content:"|63 82 53 63|"; content:"|35 01 01|"; distance:0;
    threshold:type both, track by_dst, count 30, seconds 10;
    classtype:attempted-dos; sid:9000020; rev:1;)

# ─── TCP flag-abuse floods / scans ──────────────────────────────────────────

alert tcp any any -> $HOME_NET any (msg:"NetWARRIOR XMAS flood/scan (FIN+PSH+URG)";
    flags:FPU,12; window:>0;
    threshold:type both, track by_dst, count 20, seconds 10;
    classtype:attempted-recon; sid:9000030; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"NetWARRIOR NULL flood/scan (no flags)";
    flags:0;
    threshold:type both, track by_dst, count 20, seconds 10;
    classtype:attempted-recon; sid:9000031; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"NetWARRIOR TCP zero-window flood";
    flags:A; window:0;
    threshold:type both, track by_dst, count 40, seconds 10;
    classtype:attempted-dos; sid:9000032; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"NetWARRIOR SYN flood (rate)";
    flags:S,12;
    threshold:type both, track by_dst, count 200, seconds 5;
    classtype:attempted-dos; sid:9000033; rev:1;)

# ─── Application layer ─────────────────────────────────────────────────────

alert http any any -> $HOME_NET any (msg:"NetWARRIOR Slowloris drip header (X-a:)";
    flow:established,to_server;
    content:"X-a|3a| "; http_header;
    threshold:type both, track by_src, count 5, seconds 30;
    classtype:attempted-dos; sid:9000040; rev:1;)

alert http any any -> $HOME_NET any (msg:"NetWARRIOR Slowloris/HTTP header fingerprint (lowercase Accept-language)";
    flow:established,to_server;
    content:"Accept-language|3a| en-US"; http_header;
    content:"User-Agent|3a| Mozilla/5.0|0d 0a|"; http_header;
    classtype:attempted-dos; sid:9000041; rev:1;)

alert http any any -> $HOME_NET any (msg:"NetWARRIOR RUDY slow POST (empty username field)";
    flow:established,to_server;
    content:"POST"; http_method;
    content:"username="; http_client_body; isdataat:!1,relative;
    classtype:attempted-dos; sid:9000042; rev:1;)

alert http any any -> $HOME_NET any (msg:"NetWARRIOR HTTP request flood (rate)";
    flow:established,to_server;
    threshold:type both, track by_src, count 100, seconds 5;
    classtype:attempted-dos; sid:9000043; rev:1;)

alert http any any -> $HOME_NET any (msg:"NetWARRIOR WebSocket handshake flood";
    flow:established,to_server;
    content:"Upgrade|3a| websocket"; http_header;
    content:"Sec-WebSocket-Key|3a| dGhlIHNhbXBsZSBub25jZQ=="; http_header;
    threshold:type both, track by_src, count 10, seconds 10;
    classtype:attempted-dos; sid:9000044; rev:1;)

# ─── Phishing harvester ────────────────────────────────────────────────────

alert http $HOME_NET any -> any any (msg:"NetWARRIOR phishing harvester - credential POST to /login";
    flow:established,to_server;
    content:"POST"; http_method; content:"/login"; http_uri;
    content:"password="; http_client_body;
    classtype:credential-theft; sid:9000050; rev:1;)

alert http any any -> $HOME_NET any (msg:"NetWARRIOR phishing harvester response (Login failed / 401)";
    flow:established,to_client;
    content:"401"; http_stat_code;
    content:"Login failed"; http_server_body;
    classtype:credential-theft; sid:9000051; rev:1;)

# ─── Recon ────────────────────────────────────────────────────────────────

alert tcp any any -> $HOME_NET any (msg:"NetWARRIOR async port scan (many ports, one source)";
    flags:S,12;
    threshold:type both, track by_src, count 30, seconds 5;
    classtype:attempted-recon; sid:9000060; rev:1;)
